generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id               String                    @id @default(uuid())
  clerkUserId      String                    @unique
  email            String                    @unique
  name             String?
  memberships      OrganizationMember[]
  joinRequests     OrganizationJoinRequest[] @relation("JoinRequestUser")
  reviewedRequests OrganizationJoinRequest[] @relation("JoinRequestReviewer")
  invitationsSent  OrganizationInvitation[]  @relation("OrganizationInvitationInviter")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  githubConnection GitHubConnection?
}


model GitHubConnection {
  id             String   @id @default(uuid())
  userId         String   @unique
  installationId BigInt
  accountId      BigInt
  accountLogin   String
  accountType    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([installationId])
  @@index([accountId])
}


model Organization {
  id             String                    @id @default(uuid())
  name           String
  normalizedName String                    @unique
  slug           String                    @unique
  members        OrganizationMember[]
  joinRequests   OrganizationJoinRequest[]
  invitations    OrganizationInvitation[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
}

model OrganizationMember {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(DEVELOPER)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  joinedAt       DateTime         @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model OrganizationJoinRequest {
  id             String            @id @default(uuid())
  userId         String
  organizationId String
  status         JoinRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())

  user         User         @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("JoinRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  email          String
  tokenHash      String           @unique
  role           OrganizationRole @default(DEVELOPER)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  organizationId String
  createdAt      DateTime         @default(now())

  invitedBy User @relation("OrganizationInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, email, status])
  @@index([email, status])
}
